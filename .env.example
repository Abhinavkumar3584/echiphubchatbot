# Copy to .env and fill in. Never commit .env (it is in .gitignore).

# ---- Amazon Bedrock (IAM user with the policy in iam-policy-bedrock.json)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
LLM_MODEL=apac.amazon.nova-lite-v1:0
LLM_FALLBACK_MODEL=none

# ---- websites allowed to use the chatbot (comma-separated, exact origins)
ALLOWED_ORIGINS=https://echiphub.in,https://www.echiphub.in,https://events.echiphub.in,https://edx.echiphub.in,https://community.echiphub.in,https://labs.echiphub.in,http://127.0.0.1:8002

# ---- scraper only (laptop): test account for the sign-in-only pages
SCRAPER_EMAIL=
SCRAPER_PASSWORD=

# ---- optional (defaults shown)
# TOP_K=12
# MAX_CONTEXT_CHARS=6500
# MIN_SCORE=0.52
# REWRITE_FOLLOWUPS=true
# LLM_MAX_CONCURRENCY=200
# RATE_LIMIT_PER_MINUTE=12
# DAILY_QUESTION_LIMIT=100
# GUARDRAILS=true