# Copy this file to .env and fill in GROQ_API_KEY. Never share or commit .env.

# --- Answers (Groq) - get a key at https://console.groq.com/keys
GROQ_API_KEY=gsk_your_key_here
GROQ_MODEL=openai/gpt-oss-20b
GROQ_FALLBACK_MODEL=openai/gpt-oss-120b
REASONING_EFFORT=low

# --- Vector database (Qdrant)
# empty = built-in local database in data/qdrant (runs locally)
QDRANT_URL=
COLLECTION=echiphub

# --- Embeddings (run locally, no key needed)
EMBED_MODEL=BAAI/bge-small-en-v1.5

# --- Search: below this similarity the bot says "not found" (tune with: python evaluate.py)
MIN_SCORE=0.50
TOP_K=6

# --- Web server
# websites allowed to use the chat bubble (comma separated)
ALLOWED_ORIGINS=https://echiphub.in,https://www.echiphub.in,https://events.echiphub.in,https://edx.echiphub.in,https://community.echiphub.in,https://labs.echiphub.in,http://localhost:8000,http://127.0.0.1:8000
RATE_LIMIT_PER_MINUTE=12
SUPPORT_CONTACT=support-edtech@nielit.ac.in
# a long random text; then open /admin/stats?token=THAT to see questions and feedback
ADMIN_TOKEN=
